{
  "name": "frontend",
  "version": "2.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/next/dist/bin/next dev --webpack -p 30101",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:build-ts": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build-ts && concurrently --kill-others \"npm run dev\" \"wait-on http://localhost:30101 && cross-env ELECTRON_DEV_URL=http://localhost:30101 electron .\"",
    "electron:prebuild": "npm run electron:build-ts && npm run electron:config",
    "electron:prepare-mac-icon": "node scripts/prepare-mac-icon.js",
    "electron:build": "npm run electron:prebuild && electron-builder --win --config electron-builder.yml",
    "electron:build:mac": "npm run electron:prepare-mac-icon && npm run electron:prebuild && electron-builder --mac --config electron-builder.yml",
    "electron:publish": "npm run electron:prebuild && electron-builder --win --config electron-builder.yml --publish always",
    "electron:publish:mac": "npm run electron:prepare-mac-icon && npm run electron:prebuild && electron-builder --mac --config electron-builder.yml --publish always",
    "electron:config": "node scripts/write-app-config.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.7.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.1.1",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  }
}
