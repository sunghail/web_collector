# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Keep it secret: it can read and write every table.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs login cookies. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Download buttons read the newest release from this GitHub repo.
# GITHUB_RELEASE_REPO=sunghail/web_collector
# Optional. Any GitHub token with no scopes raises the rate limit for the release lookup.
# GITHUB_TOKEN=
